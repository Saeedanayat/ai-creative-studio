# Copy this file to ".env" (same folder) and fill in your own values.
# NEVER share your .env file or upload it to GitHub.

# Hugging Face access token (free to create). Needed for REAL image generation.
# Create one at: https://huggingface.co/settings/tokens  (a "Read" token is enough;
# for "fine-grained" tokens, enable permission to call Inference Providers)
HF_TOKEN=

# Optional: choose a different text-to-image model from the Hugging Face Hub.
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
